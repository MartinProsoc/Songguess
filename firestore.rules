// ==========================================
// FIRESTORE BIZTONSÁGI SZABÁLYOK
// ==========================================
// Ezt kell bemásolnod a Firebase Console-ban:
// (a projekted) → Build → Firestore Database → Rules fül → illeszd be → Publish
//
// Ez garantálja, hogy mindenki KIZÁRÓLAG a saját profilját tudja olvasni/írni
// (a bejelentkezett felhasználó UID-ja alapján) — más felhasználó adatát senki
// nem tudja elolvasni vagy módosítani.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // MULTIPLAYER SZOBÁK
    // ==========================================
    // A "rooms" gyűjtemény tárolja az élő szobákat (kód alapú és gyorsjáték egyaránt).
    // Bárki hitelesített felhasználó (bejelentkezett fiók VAGY névtelen/anonymous munkamenet,
    // lásd firebase-config.js -> ensureFirebaseUserForMultiplayer) olvashatja a szobákat —
    // ez kell ahhoz, hogy kód alapján rá lehessen keresni egy szobára, és hogy a gyorsjáték
    // funkció listázni tudja a nyitott, várakozó szobákat.
    //
    // A szoba dokumentumát (beállítások, dalok, kör-állapot) alapesetben KIZÁRÓLAG a szoba
    // gazdája (hostUid) hozhatja létre / módosíthatja / törölheti — így egy másik játékos nem
    // tudja meghekkelni a kört vagy a dalokat. A csatlakozás és a kilépés a "players"
    // algyűjteményen keresztül történik, ahol mindenki KIZÁRÓLAG a saját (uid nevű)
    // dokumentumát írhatja.
    //
    // Ez alól két szűk kivétel van, mindkettő csak akkor él, ha a gazda ELTŰNT (nincs már
    // játékos-dokumentuma a szobában, vagy a jelenlét-bélyege — lastSeen — régebbi 60
    // másodpercnél, mert bezárta a fület / megszakadt a kapcsolata):
    //   1) a szobában maradt egyik játékos átveheti a gazda szerepét (de KIZÁRÓLAG a
    //      hostUid/hostName mezőket írhatja, semmi mást),
    //   2) az így gazdátlanul maradt szoba törölhető — erre támaszkodik a gyorsjáték,
    //      amikor eltakarítja a kiürült szobákat, mielőtt újat nyitna.
    match /rooms/{roomId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function playerDoc(playerUid) {
        return /databases/$(database)/documents/rooms/$(roomId)/players/$(playerUid);
      }
      function inRoom() { return signedIn() && exists(playerDoc(uid())); }
      function isHost() { return signedIn() && resource.data.hostUid == uid(); }

      // A hiányzó lastSeen-t szándékosan FRISSNEK vesszük (alapérték: request.time), hogy egy
      // régebbi kliensverzió gazdáját ne lehessen csak úgy leváltani.
      function hostGone() {
        return !exists(playerDoc(resource.data.hostUid))
            || get(playerDoc(resource.data.hostUid)).data.get('lastSeen', request.time)
               < request.time - duration.value(60, 's');
      }

      function onlyChanges(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == uid();

      allow update: if isHost()
        || (inRoom() && hostGone()
            && onlyChanges(['hostUid', 'hostName'])
            && request.resource.data.hostUid == uid());

      allow delete: if isHost() || (signedIn() && hostGone());

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == playerId;
      }
    }

    // ==========================================
    // RANGLISTA
    // ==========================================
    // A "leaderboard" gyűjtemény egy dokumentuma (uid szerint) egy játékos nyilvános
    // ranglista-bejegyzése (felhasználónév, XP, szint, országkód). Bárki hitelesített
    // felhasználó olvashatja mindet (ez kell a Globális/Helyi ranglista listázásához,
    // vendégként/névtelen munkamenettel is), de írni KIZÁRÓLAG a saját dokumentumát tudja
    // valaki, és csak ezt a néhány mezőt — ÉS csak akkor, ha valódi (nem névtelen) fiókkal
    // van bejelentkezve. Ez utóbbit nem csak a kliensoldali kód (leaderboard.js) dönti el,
    // hanem ez a szabály is kikényszeríti (sign_in_provider != 'anonymous'), hogy egy
    // vendég semmiképp ne kerülhessen fel a ranglistára, még a kliensoldali ellenőrzés
    // megkerülésével sem.
    //
    // Megjegyzés: mivel ez egy tisztán kliensoldali (szerver nélküli) alkalmazás, ez a
    // szabály nem tudja ellenőrizni, hogy a beküldött XP ténylegesen a játékban szerzett
    // pontszámmal egyezik-e — egy hozzáértő, bejelentkezett felhasználó elméletileg
    // meghamisíthatná a sajátját. Egy csalásbiztos ranglistához szerver oldali (Cloud
    // Function) érvényesítés kellene.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['username', 'xp', 'level', 'countryCode', 'updatedAt'])
        && request.resource.data.xp is number && request.resource.data.xp >= 0;
    }

    // ==========================================
    // FELHASZNÁLÓNÉV-FOGLALÁSOK (egyediség)
    // ==========================================
    // A "usernames" gyűjtemény egy dokumentuma egy lefoglalt (normalizált — kisbetűs, ékezet
    // nélküli) felhasználónevet képvisel, a dokumentum ID-ja maga a normalizált név, tartalma
    // pedig a foglaló fiók uid-ja. Ez zárja ki, hogy két fiók ugyanazt a (nagy/kisbetűtől és
    // ékezettől független) nevet viselje — lásd script.js -> claimUsername().
    //
    // Csak valódi (nem névtelen) fiók foglalhat/módosíthat/szabadíthat fel nevet, és mindig
    // KIZÁRÓLAG a saját uid-jához tartozót. A tényleges "csak egyszer foglalható" garanciát
    // a kliens oldali runTransaction() adja (beolvasás + írás egy atomi lépésben) — ez a
    // szabály "csak" azt biztosítja, hogy senki ne tudjon más nevében foglalni/felszabadítani.
    match /usernames/{normalizedName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
